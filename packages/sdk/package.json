{
  "name": "@p402/sdk",
  "version": "1.2.0",
  "description": "Official TypeScript SDK for the P402 AI Payment Router — x402 protocol, multi-provider routing, session budgets, Tempo multi-rail settlement",
  "author": "P402 Protocol <dev@p402.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Z333Q/p402-protocol.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://p402.io",
  "bugs": {
    "url": "https://github.com/Z333Q/p402-protocol/issues"
  },
  "keywords": [
    "p402", "x402", "payments", "ai", "agents",
    "eip-3009", "eip-712", "usdc", "base", "openai"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "viem": "^2.42.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
